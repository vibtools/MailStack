DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=<generate-at-deployment>
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=app.example.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DB_ENGINE=mariadb
DB_NAME=vibmail_app
DB_USER=vibmail_app
DB_PASSWORD=<set-a-strong-random-password>
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
# Leave empty for local loopback MariaDB unless TLS is explicitly configured.
DB_SSL_CA=
MAILSERVER_INTEGRATION_ENABLED=true
MAILSERVER_DB_NAME=vibmail
MAILSERVER_DOMAIN_TABLE=mail_domains
MAILSERVER_MAILBOX_TABLE=mailboxes
MAILSERVER_ALIAS_TABLE=mail_aliases
MAILSERVER_POSTFIX_VIEW=postfix_virtual_mailboxes
MAILBOX_DEFAULT_QUOTA_BYTES=2147483648
MAILBOX_PROVISION_LOCK_ROOT=/run/vibmail/mailbox-provision-locks
MAILBOX_PROVISION_LOCK_TIMEOUT_SECONDS=15
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
APP_HOSTNAME=app.example.com
SOURCE_CODE_URL=https://github.com/vibtools/MailStack
COMPANY_URL=https://vib.tools/
OPEN_SOURCE_HUB_URL=https://dev.vib.tools/
SUBDOMAIN_SERVICE_URL=https://ygit.net/
SERVER_IP=127.0.0.1
MAIL_STORAGE_ROOT=/var/vmail
ATTACHMENT_STORAGE_ROOT=/var/lib/vibmail/attachments
MAX_MESSAGE_SIZE_MB=25
MAX_ATTACHMENT_SIZE_MB=20
INGESTION_INTERVAL_SECONDS=15
INGESTION_LOCK_FILE=/run/vibmail-ingestion/ingestion.lock
SESSION_COOKIE_AGE=3600
SECURE_SSL_REDIRECT=true
SECURE_HSTS_PRELOAD=true
TRUST_PROXY_HEADERS=true
LOG_LEVEL=INFO
LOG_DIRECTORY=/var/log/vibmail
STATIC_ROOT=/var/lib/vibmail/static
USE_X_ACCEL_REDIRECT=false

LIVE_UPDATE_VISIBLE_MAILBOX_LIMIT=50
